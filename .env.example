# Copy this file to .env and change the values:  cp .env.example .env
MYSQL_ROOT_PASSWORD=change_root_password
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=change_db_password
# Must be the SAME on every EC2 instance so login cookies are valid behind the load balancer
JWT_SECRET=change_this_to_a_long_random_string
WEB_PORT=80
# Filled automatically on EC2 by aws/user-data.sh (instance metadata)
SERVER_NAME=
AVAILABILITY_ZONE=local
